NODE_ENV=development
PORT=5000
# MongoDB Atlas -> Connect -> Drivers -> copy the string, put your password in
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gadgets
# FORCE_PUBLIC_DNS=true   # only if Atlas address won't resolve on your network

JWT_SECRET=change-me-to-a-long-random-string-at-least-24-chars
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong

CLIENT_URL=http://localhost:5173
# SERVER_URL=https://api.yourdomain.com   # public address of this backend

# Razorpay (Dashboard -> Account & Settings -> API keys). Empty = COD only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_DISCOUNT_PERCENT=10
COD_ENABLED=true

# Email (Gmail: smtp.gmail.com, port 465, use an App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GADGETÉ <orders@yourdomain.com>"
ORDER_ALERT_EMAIL=
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Shipway (app.shipway.com) — login email + License Key from Shipway → Profile → Manage Profile
SHIPWAY_EMAIL=
SHIPWAY_LICENSE_KEY=
# live = real courier booking (charges wallet) · create_only = test, no courier · mock = fake test data
SHIPWAY_MODE=live
# Optional: pickup warehouse ID. Leave blank to use your DEFAULT warehouse in Shipway automatically.
SHIPWAY_WAREHOUSE_ID=
SHIPWAY_RETURN_WAREHOUSE_ID=
# Optional: leave blank — you pick the courier (with prices) in the admin panel when shipping.
SHIPWAY_CARRIER_ID=
# Pickup slot asked for when booking (India time, hh:mm)
SHIPWAY_PICKUP_TIME=14:00
SHIPWAY_OFFICE_CLOSE_TIME=18:00
# Any long secret you choose. In Shipway → Track → Tracking Webhooks add:
#   https://YOURDOMAIN/api/delivery/updates?token=<this value>
SHIPWAY_WEBHOOK_TOKEN=
# Fallback parcel for products without "Shipping (for courier)" details in Admin → Products
SHIPWAY_ITEM_WEIGHT_KG=0.5
SHIPWAY_BOX_LENGTH_CM=15
SHIPWAY_BOX_BREADTH_CM=15
SHIPWAY_BOX_HEIGHT_CM=10

# Cloudinary (cloudinary.com → Settings → API Keys) — product photo + video uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
