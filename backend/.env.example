NODE_ENV=development
PORT=5000
# MongoDB Atlas -> Connect -> Drivers -> copy the string, put your password in
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gadgets
# FORCE_PUBLIC_DNS=true   # only if Atlas address won't resolve on your network

JWT_SECRET=change-me-to-a-long-random-string-at-least-24-chars
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong

CLIENT_URL=http://localhost:5173
# SERVER_URL=https://api.yourdomain.com   # public address of this backend

# Razorpay (Dashboard -> Account & Settings -> API keys). Empty = COD only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_DISCOUNT_PERCENT=10
COD_ENABLED=true

# Email (Gmail: smtp.gmail.com, port 465, use an App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GADGETÉ <orders@yourdomain.com>"
ORDER_ALERT_EMAIL=
SUPPORT_EMAIL=
SUPPORT_PHONE=
