NODE_ENV=development
PORT=5000
# MongoDB Atlas -> Connect -> Drivers -> copy the string, put your password in
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gadgets
# FORCE_PUBLIC_DNS=true   # only if Atlas address won't resolve on your network

JWT_SECRET=change-me-to-a-long-random-string-at-least-24-chars
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong

CLIENT_URL=http://localhost:5173
# SERVER_URL=https://api.yourdomain.com   # public address of this backend

# Razorpay (Dashboard -> Account & Settings -> API keys). Empty = COD only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_DISCOUNT_PERCENT=10
COD_ENABLED=true

# Email (Gmail: smtp.gmail.com, port 465, use an App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GADGETÉ <orders@yourdomain.com>"
ORDER_ALERT_EMAIL=
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Shiprocket (panel → Settings → API → Create API User — use those details here)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# live = real courier booking (charges wallet) · create_only = test, no courier · mock = fake test data
SHIPROCKET_MODE=live
# The pickup address nickname from Shiprocket → Settings → Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=Primary
# Any secret you choose; enter the same in Shiprocket → Settings → API → Webhooks
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_ITEM_WEIGHT_KG=0.5
SHIPROCKET_BOX_LENGTH_CM=15
SHIPROCKET_BOX_BREADTH_CM=15
SHIPROCKET_BOX_HEIGHT_CM=10
