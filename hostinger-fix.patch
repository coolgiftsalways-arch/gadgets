From 76cef9c7846c9397cf2a5bfeb928665454583618 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 13 Nov 2026 12:48:40 +0000
Subject: [PATCH] Fix Hostinger start: no top-level await in server.js

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HALAYwtR84NkZ9xzqNu8Jr
---
 backend/server.js | 63 ++++++++++++++++++++++++++++-------------------
 1 file changed, 37 insertions(+), 26 deletions(-)

diff --git a/backend/server.js b/backend/server.js
index 027a45f..76f27a2 100644
--- a/backend/server.js
+++ b/backend/server.js
@@ -1,3 +1,5 @@
+// Starts the store. Written without top-level await so hosts that load the
+// entry file with require() (Hostinger / LiteSpeed) can start it too.
 import mongoose from "mongoose";
 import { env, checkEnv } from "./config/env.js";
 import { connectDB } from "./config/db.js";
@@ -6,34 +8,43 @@ import { startPaymentSweep } from "./services/paymentSweep.js";
 import { backgroundIdle } from "./services/background.js";
 import { seedIfEmpty } from "./seed/seedProducts.js";
 
-const { errors, warnings } = checkEnv();
-warnings.forEach((w) => console.warn("⚠", w));
-if (errors.length) {
-  errors.forEach((e) => console.error("✖", e));
-  process.exit(1);
-}
+// Some hosts hand over a socket path in PORT instead of a port number.
+const rawPort = String(process.env.PORT || "");
+const listenOn = rawPort && !/^\d+$/.test(rawPort) ? rawPort : env.port;
 
-try {
-  await connectDB(env.mongoUri);
-} catch (error) {
-  console.error("MongoDB connection failed:", error.message);
-  if (error.hint) console.error("→", error.hint);
-  process.exit(1);
-}
+async function main() {
+  const { errors, warnings } = checkEnv();
+  warnings.forEach((warning) => console.warn("⚠", warning));
+  if (errors.length) {
+    errors.forEach((error) => console.error("✖", error));
+    process.exit(1);
+  }
 
-await seedIfEmpty();
+  try {
+    await connectDB(env.mongoUri);
+  } catch (error) {
+    console.error("MongoDB connection failed:", error.message);
+    if (error.hint) console.error("→", error.hint);
+    process.exit(1);
+  }
 
-const server = createApp().listen(env.port, () =>
-  console.log(`Server running on http://localhost:${env.port}`),
-);
-const stopSweep = startPaymentSweep();
+  await seedIfEmpty();
 
-async function shutdown() {
-  stopSweep();
-  server.close();
-  await backgroundIdle();
-  await mongoose.disconnect();
-  process.exit(0);
+  const server = createApp().listen(listenOn, () => console.log(`Server running on ${listenOn}`));
+  const stopSweep = startPaymentSweep();
+
+  const shutdown = async () => {
+    stopSweep();
+    server.close();
+    await backgroundIdle();
+    await mongoose.disconnect();
+    process.exit(0);
+  };
+  process.on("SIGINT", shutdown);
+  process.on("SIGTERM", shutdown);
 }
-process.on("SIGINT", shutdown);
-process.on("SIGTERM", shutdown);
+
+main().catch((error) => {
+  console.error("Server failed to start:", error);
+  process.exit(1);
+});
-- 
