From 4d0a639fa54661feba50a97693facbf0f43fefda Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 16 Nov 2026 10:57:20 +0000
Subject: [PATCH] Shop cards: photos/videos fill the card, fix old price +
 discount layout

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HALAYwtR84NkZ9xzqNu8Jr
---
 frontend/src/Pages/Shop.jsx |  9 +++---
 frontend/src/Style/Shop.css | 60 +++++++++++++++++++++++++++++++++++++
 2 files changed, 64 insertions(+), 5 deletions(-)

diff --git a/frontend/src/Pages/Shop.jsx b/frontend/src/Pages/Shop.jsx
index 7e6f6b3..7abb16e 100644
--- a/frontend/src/Pages/Shop.jsx
+++ b/frontend/src/Pages/Shop.jsx
@@ -782,28 +782,27 @@ export default function Shop() {
 
                     {/* PRODUCT IMAGE / ICON */}
 
-                    <div className="shop-product-visual">
+                    <div className={`shop-product-visual ${video || image ? "has-media" : ""}`}>
 
-                      <div className="shop-product-glow" />
+                      {!video && !image && <div className="shop-product-glow" />}
 
                       {video ? (
                         <video
                           src={video}
                           poster={image || undefined}
-                          className="shop-product-icon"
+                          className="shop-product-media"
                           muted
                           loop
                           autoPlay
                           playsInline
                           preload="metadata"
                           aria-label={productName}
-                          style={{ width: "100%", height: "100%", objectFit: "cover", borderRadius: 12 }}
                         />
                       ) : image ? (
                         <img
                           src={image}
                           alt={productName}
-                          className="shop-product-icon"
+                          className="shop-product-media"
                           loading="lazy"
                           onError={(event) => {
                             event.currentTarget.style.display = "none";
diff --git a/frontend/src/Style/Shop.css b/frontend/src/Style/Shop.css
index f77ebd8..a444c93 100644
--- a/frontend/src/Style/Shop.css
+++ b/frontend/src/Style/Shop.css
@@ -467,6 +467,66 @@
      filter: drop-shadow(15px 20px 15px rgba(0, 0, 0, 0.15));
 }
 
+/* Photos and videos fill the whole image area of the card */
+.shop-product-visual.has-media {
+     min-height: 0;
+     flex: none;
+     aspect-ratio: 1 / 1;
+     margin-bottom: 14px;
+     border-radius: 12px;
+     background: #ffffff;
+}
+
+.shop-product-media {
+     position: absolute;
+     inset: 0;
+     z-index: 1;
+     width: 100%;
+     height: 100%;
+     display: block;
+     object-fit: cover;
+     border-radius: 12px;
+     transition: transform 0.5s ease;
+}
+
+.shop-product-card:hover .shop-product-media {
+     transform: scale(1.05);
+}
+
+.shop-product-visual.has-media .shop-product-index {
+     z-index: 2;
+     left: 10px;
+     bottom: 10px;
+     padding: 4px 8px;
+     border-radius: 6px;
+     background: rgba(255, 255, 255, 0.85);
+     opacity: 1;
+}
+
+/* Old price + discount on one line, clearly separated */
+.shop-product-original-price {
+     display: flex;
+     align-items: center;
+     gap: 8px;
+     margin: 4px 0 8px;
+     font-size: 13px;
+}
+
+.shop-product-original-price span:first-child {
+     color: #85847b;
+     text-decoration: line-through;
+}
+
+.shop-product-original-price span:last-child:not(:first-child) {
+     padding: 2px 7px;
+     border-radius: 4px;
+     background: #eff04c;
+     color: #10100e;
+     font-weight: 700;
+     font-size: 11px;
+     letter-spacing: 0.5px;
+}
+
 .shop-product-index {
      position: absolute;
      left: 0;
-- 
