+     padding: 4px 8px;
+     background: transparent;
+     border: 1px solid var(--gad-admin-line);
+     border-radius: 6px;
+     color: inherit;
+     font-size: 11px;
+     font-weight: 700;
+     letter-spacing: .08em;
+     cursor: pointer;
+}
+
+.gad-order-edit-form {
+     display: grid;
+     gap: 10px;
+     margin-top: 8px;
+}
+
+.gad-order-edit-form label {
+     display: grid;
+     gap: 4px;
+     font-size: 12px;
+     opacity: .85;
+}
+
+.gad-order-edit-form input,
+.gad-order-edit-form select {
+     width: 100%;
+     height: 40px;
+     padding: 0 10px;
+     background: transparent;
+     border: 1px solid currentColor;
+     border-radius: 8px;
+     color: inherit;
+     font-size: 15px;
+}
+
+.gad-order-edit-form select option {
+     color: #10100e;
+}
+
+.gad-order-edit-row {
+     display: grid;
+     grid-template-columns: 1fr 120px;
+     gap: 10px;
+}
+
+/* Phone + address columns in the orders list */
+.gad-order-phone-cell {
+     white-space: nowrap;
+}
+
+.gad-order-phone-cell a {
+     display: inline-flex;
+     align-items: center;
+     gap: 6px;
+     color: inherit;
+     font-weight: 600;
+     text-decoration: none;
+}
+
+.gad-order-phone-cell svg {
+     color: var(--gad-admin-muted);
+}
+
+.gad-order-address-missing {
+     color: #b8620c;
+     font-style: italic;
+}
+
+.gad-order-phone-cell a:hover {
+     text-decoration: underline;
+}
+
+.gad-order-address-cell {
+     min-width: 230px;
+     max-width: 320px;
+     line-height: 1.45;
+     white-space: normal;
+}
+
+.gad-order-address-cell span,
+.gad-order-address-cell small {
+     display: block;
+     overflow-wrap: anywhere;
+}
+
+.gad-order-address-cell small {
+     margin-top: 4px;
+     color: var(--gad-admin-muted);
+     font-size: 12px;
+}
+
+
+/* ---------- Orders list on phones: one clear card per order ---------- */
+@media (max-width: 700px) {
+     .gad-orders-table tr {
+          grid-template-columns: minmax(0, 1fr) auto;
+          grid-template-areas:
+               "id       status"
+               "customer customer"
+               "phone    phone"
+               "address  address"
+               "products products"
+               "date     total"
+               "payment  view";
+          gap: 10px 12px;
+          padding: 16px;
+          border-radius: 14px;
+     }
+
+     .gad-orders-table tbody tr:nth-child(even) {
+          background: var(--gad-admin-panel);
+     }
+
+     .gad-orders-table tbody td.gad-order-id-cell {
+          grid-area: id;
+          align-self: center;
+          font-size: 13px !important;
+     }
+
+     .gad-orders-table tbody td.gad-order-status-cell {
+          grid-area: status;
+          justify-self: end;
+     }
+
+     .gad-orders-table tbody td.gad-order-customer-cell {
+          grid-area: customer;
+          padding-bottom: 10px !important;
+          border-bottom: 1px dashed var(--gad-admin-line) !important;
+     }
+
+     .gad-order-customer {
+          min-width: 0;
+     }
+
+     .gad-orders-table tbody td.gad-order-phone-cell {
+          grid-area: phone;
+          font-size: 14px;
+     }
+
+     .gad-orders-table tbody td.gad-order-address-cell {
+          grid-area: address;
+          min-width: 0;
+          max-width: none;
+          font-size: 13px;
+     }
+
+     .gad-orders-table tbody td.gad-order-products-cell {
+          grid-area: products;
+          min-width: 0;
+          max-width: none;
+          padding: 10px 12px !important;
+          background: var(--gad-admin-page);
+          border-radius: 10px;
+     }
+
+     .gad-orders-table tbody td.gad-order-date-cell {
+          grid-area: date;
+          align-self: center;
+     }
+
+     .gad-orders-table tbody td.gad-order-date-cell strong,
+     .gad-orders-table tbody td.gad-order-date-cell small {
+          display: inline;
+          margin: 0;
+     }
+
+     .gad-orders-table tbody td.gad-order-date-cell small::before {
+          content: " · ";
+     }
+
+     .gad-orders-table tbody td.gad-order-total-cell {
+          grid-area: total;
+          justify-self: end;
+          align-self: center;
+          font-size: 17px;
+     }
+
+     .gad-orders-table tbody td.gad-order-payment-cell {
+          grid-area: payment;
+          align-self: center;
+     }
+
+     .gad-orders-table tbody td.gad-order-view-cell {
+          grid-area: view;
+          justify-self: end;
+     }
+}
+
+/* Courier picker in the Shipway section */
+.gad-ship-courier {
+     display: grid;
+     gap: 8px;
+     margin: 10px 0 4px;
+     padding: 12px;
+     border: 1px solid var(--gad-admin-line);
+     border-radius: 10px;
+}
+
+.gad-ship-courier .gad-orders-note {
+     margin: 0;
+}
+
+.gad-ship-courier-label {
+     display: flex;
+     align-items: center;
+     gap: 8px;
+     font-size: 11px;
+     font-weight: 800;
+     letter-spacing: .08em;
+}
+
+.gad-ship-courier select {
+     width: 100%;
+     height: 42px;
+     padding: 0 10px;
+     background: transparent;
+     border: 1px solid currentColor;
+     border-radius: 8px;
+     color: inherit;
+     font-size: 14px;
+}
+
+.gad-ship-courier select option {
+     color: #10100e;
+}
+
+.gad-ship-waiting {
+     display: grid;
+     gap: 4px;
+     margin: 6px 0;
+     padding: 12px 14px;
+     background: rgba(62, 157, 105, .1);
+     border: 1px solid rgba(62, 157, 105, .35);
+     border-radius: 10px;
+     font-size: 13px;
+     line-height: 1.5;
+}
+
+.gad-ship-waiting strong {
+     color: #2f8a57;
+}
+
+/* Parcel (weight + box) in the Shipway section */
+.gad-ship-parcel {
+     display: grid;
+     gap: 8px;
+     margin: 8px 0 4px;
+     padding: 12px;
+     border: 1px dashed var(--gad-admin-line);
+     border-radius: 10px;
+}
+
+.gad-ship-parcel-head {
+     display: flex;
+     flex-wrap: wrap;
+     align-items: baseline;
+     gap: 4px 10px;
+}
+
+.gad-ship-parcel-head strong {
+     font-size: 11px;
+     letter-spacing: .08em;
+}
+
+.gad-ship-parcel-head span {
+     color: var(--gad-admin-muted);
+     font-size: 12px;
+}
+
+.gad-ship-parcel-grid {
+     display: grid;
+     grid-template-columns: repeat(4, minmax(0, 1fr));
+     gap: 8px;
+}
+
+.gad-ship-parcel-grid label {
+     display: grid;
+     gap: 4px;
+     color: var(--gad-admin-muted);
+     font-size: 11px;
+}
+
+.gad-ship-parcel-grid input {
+     width: 100%;
+     height: 38px;
+     padding: 0 8px;
+     background: transparent;
+     border: 1px solid currentColor;
+     border-radius: 8px;
+     color: var(--gad-admin-text);
+     font-size: 14px;
+}
+
+@media (max-width: 520px) {
+     .gad-ship-parcel-grid {
+          grid-template-columns: repeat(2, minmax(0, 1fr));
+     }
+}
+
+.gad-orders-export.gad-orders-export-outline {
+     background: transparent !important;
+     border: 1px solid currentColor !important;
+     color: inherit !important;
+}
