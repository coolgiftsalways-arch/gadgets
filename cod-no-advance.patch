From: Claude <noreply@anthropic.com>
Date: Wed, 25 Nov 2026 07:10:04 +0000
Subject: [PATCH] =?UTF-8?q?COD:=20no=20=E2=82=B949=20advance=20=E2=80=94?=
 =?UTF-8?q?=20customers=20place=20Cash=20on=20Delivery=20orders=20directly?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

COD_ADVANCE now defaults to 0. The payment terms and cancellation policy no
longer mention a COD confirmation payment.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HALAYuw82s3VFw2zbyoURm
---
 backend/.env.example         | 5 +++--
 backend/config/env.js        | 6 +++---
 frontend/src/Pages/Legal.jsx | 4 ++--
 3 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/backend/.env.example b/backend/.env.example
index 770a6e3..992abf7 100644
--- a/backend/.env.example
+++ b/backend/.env.example
@@ -17,8 +17,9 @@ RAZORPAY_KEY_SECRET=
 RAZORPAY_WEBHOOK_SECRET=
 UPI_DISCOUNT_PERCENT=15
 COD_ENABLED=true
-# COD orders pay this much online first to confirm the order (rest in cash on delivery). 0 = off.
-COD_ADVANCE=49
+# Optional: COD orders pay this much online first to confirm the order (rest in cash on delivery).
+# 0 = off — customers place COD orders directly.
+COD_ADVANCE=0
 
 # Email (Gmail: smtp.gmail.com, port 465, use an App Password)
 SMTP_HOST=
diff --git a/backend/config/env.js b/backend/config/env.js
index ce66555..629bacb 100644
--- a/backend/config/env.js
+++ b/backend/config/env.js
@@ -86,9 +86,9 @@ export const env = {
 
     upiDiscountPercent: clamp(int("UPI_DISCOUNT_PERCENT", 10), 0, 90),
     codEnabled: bool("COD_ENABLED", true),
-    // COD orders pay this much online first (to confirm the order); the rest in cash on delivery.
-    // 0 = no advance. Only used when online payment (Razorpay) is set up.
-    codAdvance: clamp(int("COD_ADVANCE", 49), 0, 100000),
+    // Optional: COD orders pay this much online first (to confirm the order), the rest
+    // in cash on delivery. 0 (the default) = no advance — customers just place the order.
+    codAdvance: clamp(int("COD_ADVANCE", 0), 0, 100000),
     upiDelivery: {
       minDays: clamp(int("UPI_DELIVERY_MIN_DAYS", 3), 0, 60),
       maxDays: clamp(int("UPI_DELIVERY_MAX_DAYS", 5), 0, 90),
diff --git a/frontend/src/Pages/Legal.jsx b/frontend/src/Pages/Legal.jsx
index 3de3d66..afe1d01 100644
--- a/frontend/src/Pages/Legal.jsx
+++ b/frontend/src/Pages/Legal.jsx
@@ -306,7 +306,7 @@ export function Terms() {
       body: (
         <ul>
           <li><strong>Online / UPI</strong> — payments are processed securely by Razorpay. If payment is not completed within the time shown, the order is released.</li>
-          <li><strong>Cash on Delivery</strong> — pay the courier in cash at delivery. Some COD orders ask for a small online payment to confirm the order; it is part of your order total, not an extra charge, and the rest is paid in cash. Please keep the exact amount ready.</li>
+          <li><strong>Cash on Delivery</strong> — pay the courier the order amount in cash at delivery. Please keep the exact amount ready.</li>
           <li>Repeatedly refusing Cash on Delivery orders may lead to COD being turned off for your number or address.</li>
         </ul>
       ),
@@ -478,7 +478,7 @@ export function CancellationPolicy() {
       title: "Refunds for cancelled orders",
       body: (
         <p>
-          If you paid anything online — the full amount, or a small amount to confirm a Cash on Delivery order — it is
+          If you paid online, the amount is
           refunded to the original payment method within 5–7 working days of the cancellation.
         </p>
       ),
-- 
