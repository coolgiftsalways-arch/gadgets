From c3c0d64224db25a857cc93cce5b3aa0b70e5d6ef Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 16 Nov 2026 10:51:26 +0000
Subject: [PATCH] Show product videos first on product page and play them on
 shop cards

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HALAYwtR84NkZ9xzqNu8Jr
---
 frontend/src/Pages/ProductDetails.jsx |  3 ++-
 frontend/src/Pages/Shop.jsx           | 16 +++++++++++++++-
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/frontend/src/Pages/ProductDetails.jsx b/frontend/src/Pages/ProductDetails.jsx
index c01fbe0..61b7d45 100644
--- a/frontend/src/Pages/ProductDetails.jsx
+++ b/frontend/src/Pages/ProductDetails.jsx
@@ -103,9 +103,10 @@ export default function ProductDetails() {
   }, [id]);
 
   const product = live ? fromApi(live, staticProduct) : staticProduct;
+  // Videos first, then photos.
   const media = [
-    ...(product?.images || []).map((src) => ({ type: "image", src })),
     ...(product?.videos || []).map((src) => ({ type: "video", src })),
+    ...(product?.images || []).map((src) => ({ type: "image", src })),
   ];
   const current = media[activeMedia];
 
diff --git a/frontend/src/Pages/Shop.jsx b/frontend/src/Pages/Shop.jsx
index efb6bc3..7e6f6b3 100644
--- a/frontend/src/Pages/Shop.jsx
+++ b/frontend/src/Pages/Shop.jsx
@@ -722,6 +722,7 @@ export default function Shop() {
                 const ProductIcon = getProductIcon(product.icon);
 
                 const image = getProductImage(product);
+                const video = product.videos?.[0] || "";
 
                 const productId = product.id || product._id;
 
@@ -785,7 +786,20 @@ export default function Shop() {
 
                       <div className="shop-product-glow" />
 
-                      {image ? (
+                      {video ? (
+                        <video
+                          src={video}
+                          poster={image || undefined}
+                          className="shop-product-icon"
+                          muted
+                          loop
+                          autoPlay
+                          playsInline
+                          preload="metadata"
+                          aria-label={productName}
+                          style={{ width: "100%", height: "100%", objectFit: "cover", borderRadius: 12 }}
+                        />
+                      ) : image ? (
                         <img
                           src={image}
                           alt={productName}
-- 
